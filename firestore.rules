rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Règle par défaut : tout est fermé. Rien n'est lisible ni écrivable
    // tant qu'une règle plus bas ne l'autorise pas explicitement.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ------------------------------------------------------------------
    // Collection "admins" — verrouillée. Un utilisateur ne peut jamais
    // s'auto-attribuer le rôle admin (même schéma que sur GSC/AMBI241).
    // ------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // seul un ajout manuel via la console Firebase
    }

    // ------------------------------------------------------------------
    // Collection "demandes" — formulaire de contact / devis du site.
    // Désactivée pour l'instant (create: if false).
    // ------------------------------------------------------------------
    match /demandes/{id} {
      allow create: if request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.status == 'nouveau';
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Collection "membres" — un document par compte inscrit.
    // Champs attendus : nom, email, bio, photoURL, createdAt, actif
    // ------------------------------------------------------------------
    match /membres_prive/{uid} {
      // E-mails des membres : visibles seulement par le membre et l'admin
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200);
      allow update, delete: if isAdmin();
    }

    match /membres/{uid} {
      // Profils publics (annuaire des membres sur le site)
      allow read: if true;

      // Un membre crée uniquement son propre document, à l'inscription
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nom','bio','photoURL','createdAt','actif','cguAcceptees','cguDate'])
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() < 100
        && request.resource.data.actif == true;

      // Un membre modifie son propre profil, mais ne peut pas se désactiver
      // lui-même ni changer son email de compte via Firestore
      allow update: if (isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nom','bio','photoURL'])
        ) || isAdmin();

      // Seul l'admin peut supprimer un compte membre
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Collection "projets" — projets personnels et collaborations,
    // rattachés à un membre via membreId.
    // Champs attendus : membreId, titre, description, type, lien,
    // imageURL, statut, createdAt
    // ------------------------------------------------------------------
    match /projets/{id} {
      // Visible publiquement si validé ; sinon visible par son auteur
      // et par l'admin uniquement.
      allow read: if resource.data.statut == 'valide'
        || (isSignedIn() && resource.data.membreId == request.auth.uid)
        || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.membreId == request.auth.uid
        && request.resource.data.keys().hasOnly(['membreId','titre','description','type','lien','imageURL','statut','createdAt'])
        && request.resource.data.titre is string && request.resource.data.titre.size() > 0 && request.resource.data.titre.size() < 150
        && request.resource.data.description is string && request.resource.data.description.size() < 3000
        && request.resource.data.type in ['personnel','collaboration']
        && request.resource.data.statut == 'en_attente';

      // L'auteur peut modifier le contenu (repasse en attente de
      // validation) ; l'admin peut changer le statut librement.
      allow update: if (isSignedIn() && resource.data.membreId == request.auth.uid
          && request.resource.data.membreId == resource.data.membreId
          && request.resource.data.statut == 'en_attente'
        ) || isAdmin();

      allow delete: if (isSignedIn() && resource.data.membreId == request.auth.uid) || isAdmin();
    }
    // Partenaires / sponsors (accueil) : lecture publique, ecriture admin uniquement
    match /partenaires/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.nom is string
        && request.resource.data.nom.size() > 0
        && request.resource.data.nom.size() <= 60
        && (!('logo' in request.resource.data)
            || (request.resource.data.logo is string && request.resource.data.logo.size() < 200000));
      allow delete: if isAdmin();
    }

    // Visites (tracking) : creation publique strictement bornee, lecture admin
    match /visites/{id} {
      allow create: if request.resource.data.keys().hasOnly(['vid','nom','ts','jour','heure','ville','pays','page','lang','appareil','ref'])
        && request.resource.data.vid is string && request.resource.data.vid.size() <= 40
        && request.resource.data.ts is number
        && request.resource.data.jour is string && request.resource.data.jour.size() == 10
        && request.resource.data.heure is string && request.resource.data.heure.size() <= 5
        && request.resource.data.page is string && request.resource.data.page.size() <= 60
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 10
        && request.resource.data.appareil is string && request.resource.data.appareil.size() <= 12
        && (!('nom' in request.resource.data) || (request.resource.data.nom is string && request.resource.data.nom.size() <= 60))
        && (!('ville' in request.resource.data) || (request.resource.data.ville is string && request.resource.data.ville.size() <= 60))
        && (!('pays' in request.resource.data) || (request.resource.data.pays is string && request.resource.data.pays.size() <= 60))
        && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref.size() <= 60));
      allow read, delete: if isAdmin();
      allow update: if false;
    }

  }
}
